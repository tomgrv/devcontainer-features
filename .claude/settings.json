{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-staged-precommit.sh",
            "if": "Bash(git commit*)",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "cd $CLAUDE_PROJECT_DIR && npx --yes knoxgraeme/skillfish@latest install",
            "type": "command"
          }
        ]
      }
    ]
  },
  "outputStyle": "Caveman",
  "enableWorkflows": true,
  "includeCoAuthoredBy": false
}
