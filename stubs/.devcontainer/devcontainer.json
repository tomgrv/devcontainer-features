{
    "image": "mcr.microsoft.com/devcontainers/base:noble",
    "name": "",
    "features": {
        "ghcr.io/tomgrv/devcontainer-features/ai-coding:8": {},
        "ghcr.io/tomgrv/devcontainer-features/githooks:8": {},
        "ghcr.io/tomgrv/devcontainer-features/gitutils:8": {}
    },
    "remoteEnv": {},
    "postCreateCommand": {},
    "postStartCommand": {
        "gpg": "if [ -z \"$CODESPACES\" ]; then git config --global gpg.program gpg2 || true; fi",
        "safe": "git config --global --add safe.directory \"${containerWorkspaceFolder:-.}\""
    },
    "customizations": {}
}
