{
  "name": "@tomgrv/devcontainer-features-act",
  "version": "10.1.0",
  "description": "Nektos Act - GitHub Actions local runner integration",
  "files": [
    "bin/*.sh",
    "install.sh",
    "install-act.sh",
    "stubs/**/*"
  ],
  "bin": {
    "act-reset": "bin/act-reset.sh",
    "act-run": "bin/act-run.sh"
  },
  "scripts": {
    "install": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then feature-install -s .; fi",
    "install-act": "./install-act.sh",
    "postinstall": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then feature-configure -s . act; fi"
  },
  "peerDependencies": {
    "@tomgrv/devcontainer-features-common-utils": "*"
  },
  "peerDependenciesMeta": {
    "@tomgrv/devcontainer-features-common-utils": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomgrv/devcontainer-features.git",
    "directory": "src/act"
  }
}
