{
  "description": "A tool for running GitHub Actions locally",
  "id": "act",
  "dependsOn": {
    "ghcr.io/devcontainers/features/docker-in-docker:3": {
      "moby": false
    },
    "ghcr.io/tomgrv/devcontainer-features/common-utils:10": {}
  },
  "name": "Nektos Act",
  "options": {
    "version": {
      "default": "master",
      "description": "The version of act to install",
      "type": "string"
    }
  },
  "version": "10.1.0",
  "postCreateCommand": {
    "config": "feature-configure act"
  }
}
