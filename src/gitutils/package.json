{
    "name": "@tomgrv/devcontainer-features-gitutils",
    "description": "Git utilities and aliases for development workflow",
    "version": "7.18.0",
    "bin": {
        "git-align": "bins/_git-align.sh",
        "git-co": "bins/_git-co.sh",
        "git-degit": "bins/_git-degit.sh",
        "git-fix": "bins/_git-fix.sh",
        "git-fix-author": "bins/_git-fix-author.sh",
        "git-fix-blanks": "bins/_git-fix-blanks.sh",
        "git-fix-emoji": "bins/_git-fix-emoji.sh",
        "git-fix-last": "bins/_git-fix-last.sh",
        "git-fix-lock": "bins/_git-fix-lock.sh",
        "git-fix-mode": "bins/_git-fix-mode.sh",
        "git-fix-privacy": "bins/_git-fix-privacy.sh",
        "git-fix-prune": "bins/_git-fix-prune.sh",
        "git-fix-secrets": "bins/_git-fix-secrets.sh",
        "git-fix-up": "bins/_git-fix-up.sh",
        "git-forall": "bins/_git-forall.sh",
        "git-getcommit": "bins/_git-getcommit.sh",
        "git-integrate": "bins/_git-integrate.sh",
        "git-pick": "bins/_git-pick.sh",
        "git-release": "bins/_git-release.sh",
        "git-release-alpha": "bins/_git-release-alpha.sh",
        "git-release-beta": "bins/_git-release-beta.sh",
        "git-release-hotfix": "bins/_git-release-hotfix.sh",
        "git-release-prod": "bins/_git-release-prod.sh",
        "git-unset": "bins/_git-unset.sh"
    },
    "dependencies": {},
    "files": [
        "bins/*.sh",
        "install.sh",
        "install-config.sh",
        "install-gitflow.sh",
        "configure-gitflow.sh",
        "configs/**/*",
        "stubs/**/*"
    ],
    "peerDependencies": {
        "@tomgrv/devcontainer-features-common-utils": "*",
        "@tomgrv/devcontainer-features-gitversion": "*"
    },
    "peerDependenciesMeta": {
        "@tomgrv/devcontainer-features-common-utils": {
            "optional": true
        },
        "@tomgrv/devcontainer-features-gitversion": {
            "optional": true
        }
    },
    "scripts": {
        "install": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then sh ./install.sh; fi",
        "postinstall": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then configure-feature -s . gitutils; fi"
    }
}
