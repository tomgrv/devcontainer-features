{
    "id": "gitutils",
    "name": "Git Aliases",
    "description": "A feature to add useful Git aliases to your shell.",
    "version": "7.18.0",
    "dependsOn": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        },
        "ghcr.io/tomgrv/devcontainer-features/common-utils:7": {
            "utils": "jq dos2unix git-flow"
        },
        "ghcr.io/tomgrv/devcontainer-features/gitversion:7": {}
    },
    "installsAfter": [
        "ghcr.io/tomgrv/devcontainer-features/common-utils",
        "ghcr.io/tomgrv/devcontainer-features/gitversion"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "donjayamanne.githistory",
                "tomblind.scm-buttons-vscode",
                "mhutchie.git-graph",
                "arturock.gitstash",
                "github.copilot",
                "github.copilot-chat",
                "github.vscode-github-actions",
                "gitHub.vscode-pull-request-github",
                "github.codespaces",
                "waderyan.gitblame",
                "shyykoserhiy.git-autoconfig"
            ],
            "settings": {
                "explorer.excludeGitIgnore": true,
                "git.autorefresh": true
            }
        }
    },
    "postCreateCommand": {
        "config": "zz_feature -c gitutils"
    },
    "postStartCommand": {
        "blanks": "git fix blanks",
        "files": "git fix mode",
        "prune": "git fix prune"
    }
}
