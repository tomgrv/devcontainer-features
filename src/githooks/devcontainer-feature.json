{
  "customizations": {
    "vscode": {
      "extensions": [
        "vivaxy.vscode-conventional-commits",
        "softwareape.rebaser",
        "tomblind.scm-buttons-vscode"
      ],
      "settings": {
        "conventionalCommits.gitmoji": false,
        "github.copilot.chat.commitMessageGeneration.instructions": [
          {
            "file": ".github/instructions/commit.instructions.md"
          }
        ],
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },
  "description": "A feature to add useful Git hooks to your project",
  "id": "githooks",
  "dependsOn": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/tomgrv/devcontainer-features/gitutils:10": {}
  },
  "name": "Git Hooks",
  "version": "10.0.0",
  "postCreateCommand": {
    "config": "feature-configure githooks"
  }
}
