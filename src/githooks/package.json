{
  "name": "@tomgrv/devcontainer-features-githooks",
  "version": "11.4.0",
  "description": "Git hooks and linting configuration for development workflow",
  "files": [
    "bin/*.sh",
    "configure-*.sh",
    "install.sh",
    "stubs/**/*"
  ],
  "bin": {
    "sync-versions": "bin/sync-versions.sh",
    "update-version": "bin/update-version.sh"
  },
  "scripts": {
    "configure-cz": "./configure-cz.sh",
    "configure-husky": "./configure-husky.sh",
    "configure-hooks": "./configure-hooks.sh",
    "install": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then feature-install -s .; fi",
    "postinstall": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then feature-configure -s . githooks && git-hook-installplugins -- '[.prettier.plugins//\"\",.config.commitizen.path // \"\", .commitlint.extends // \"\"]'; fi",
    "test": "bats tests/"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "*",
    "@commitlint/config-workspace-scopes": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.4",
    "commit-and-tag-version": "^13.3.0",
    "commitizen": "*",
    "git-precommit-checks": "*",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-sh": "*"
  },
  "peerDependencies": {
    "@tomgrv/devcontainer-features-common-utils": "*",
    "@tomgrv/devcontainer-features-gitutils": "*"
  },
  "peerDependenciesMeta": {
    "@tomgrv/devcontainer-features-common-utils": {
      "optional": true
    },
    "@tomgrv/devcontainer-features-gitutils": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomgrv/devcontainer-features.git",
    "directory": "src/githooks"
  }
}
