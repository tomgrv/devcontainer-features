{
    "name": "@tomgrv/devcontainer-features-githooks",
    "description": "Git hooks and linting configuration for development workflow",
    "version": "7.18.0",
    "bin": {
        "commit-msg": "bins/_commit-msg.sh",
        "install-plugins": "bins/_install-plugins.sh",
        "post-checkout": "bins/_post-checkout.sh",
        "post-merge": "bins/_post-merge.sh",
        "pre-commit": "bins/_pre-commit.sh",
        "pre-push": "bins/_pre-push.sh",
        "prepare-commit-msg": "bins/_prepare-commit-msg.sh",
        "sync-versions": "bins/_sync-versions.sh",
        "update-version": "bins/_update-version.sh"
    },
    "dependencies": {
        "@commitlint/cli": "*",
        "@commitlint/config-conventional": "*",
        "@commitlint/config-workspace-scopes": "*",
        "@commitlint/cz-commitlint": "*",
        "commit-and-tag-version": "*",
        "commitizen": "*",
        "git-precommit-checks": "*",
        "lint-staged": "*",
        "prettier": "*",
        "prettier-plugin-sh": "*"
    },
    "files": [
        "bins/*.sh",
        "configure-*.sh",
        "install.sh",
        "stubs/**/*"
    ],
    "peerDependencies": {
        "@tomgrv/devcontainer-features-common-utils": "*",
        "@tomgrv/devcontainer-features-gitutils": "*"
    },
    "peerDependenciesMeta": {
        "@tomgrv/devcontainer-features-common-utils": {
            "optional": true
        },
        "@tomgrv/devcontainer-features-gitutils": {
            "optional": true
        }
    },
    "scripts": {
        "configure-cz": "./configure-cz.sh",
        "configure-hooks": "./configure-hooks.sh",
        "install": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then sh ./install.sh; fi",
        "postinstall": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then configure-feature -s . githooks; fi"
    }
}
