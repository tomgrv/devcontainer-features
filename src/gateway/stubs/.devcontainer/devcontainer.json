{
    "build": {
        "dockerfile": ".gateway/Dockerfile"
    },
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "features": {
        "ghcr.io/tomgrv/devcontainer-features/gateway:7": {}
    },
    "mounts": [
        {
            "source": "${localWorkspaceFolder}/.devcontainer/.gateway/certs",
            "target": "/usr/local/share/gateway/certs",
            "type": "bind"
        }
    ],
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
                "ukoloff.win-ca"
            ]
        }
    }
}
