{
  "name": "@tomgrv/devcontainer-features-gateway",
  "version": "9.0.0",
  "description": "SSL Inspection Gateway handling",
  "files": [
    "bin/*.sh",
    "configure-*.sh",
    "install-*.sh",
    "install.sh",
    "stubs/**/*"
  ],
  "bin": {
    "gateway-curl": "stubs/.devcontainer/.gateway/gateway-curl.sh",
    "gateway-vsix": "bin/gateway-vsix.sh"
  },
  "scripts": {
    "install": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then feature-install -s .; fi",
    "postinstall": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then feature-configure -s . gateway; fi",
    "test": "bats tests/"
  },
  "dependencies": {},
  "peerDependencies": {
    "@tomgrv/devcontainer-features-common-utils": "*"
  },
  "peerDependenciesMeta": {
    "@tomgrv/devcontainer-features-common-utils": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomgrv/devcontainer-features.git",
    "directory": "src/gateway"
  }
}
