{
    "name": "@tomgrv/devcontainer-features-gitversion",
    "version": "8.0.0",
    "description": "GitVersion integration and version management scripts",
    "files": [
        "bin/*.sh",
        "install.sh",
        "install-tools.sh",
        "configure-*.sh",
        "stubs/**/*"
    ],
    "bin": {
        "bump-changelog": "bin/bump-changelog.sh",
        "bump-tag": "bin/bump-tag.sh",
        "bump-version": "bin/bump-version.sh",
        "gv": "bin/gv.sh"
    },
    "scripts": {
        "install": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then install-feature -s .; fi",
        "postinstall": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then configure-feature -s . gitversion; fi"
    },
    "dependencies": {},
    "peerDependencies": {
        "@tomgrv/devcontainer-features-common-utils": "*"
    },
    "peerDependenciesMeta": {
        "@tomgrv/devcontainer-features-common-utils": {
            "optional": true
        }
    }
}
