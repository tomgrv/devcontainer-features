{
  "name": "@tomgrv/devcontainer-features-gitversion",
  "version": "10.1.0",
  "description": "GitVersion integration and version management scripts",
  "files": [
    "install.sh",
    "install-*.sh",
    "configure-*.sh",
    "stubs/**/*"
  ],
  "scripts": {
    "install": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then feature-install -s .; fi",
    "postinstall": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then feature-configure -s . gitversion; fi"
  },
  "dependencies": {},
  "peerDependencies": {
    "@tomgrv/devcontainer-features-common-utils": "*"
  },
  "peerDependenciesMeta": {
    "@tomgrv/devcontainer-features-common-utils": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomgrv/devcontainer-features.git",
    "directory": "src/gitversion"
  }
}
