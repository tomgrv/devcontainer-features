{
  "name": "@tomgrv/devcontainer-features-larasets",
  "version": "8.26.0",
  "description": "Laravel development settings and utilities",
  "files": [
    "bin/*.sh",
    "config/**/*",
    "configure-*.sh",
    "install.sh",
    "install-*.sh",
    "stubs/**/*"
  ],
  "bin": {
    "art": "bin/art.sh",
    "dep": "bin/dep.sh",
    "fwd": "bin/fwd.sh",
    "run": "bin/run.sh",
    "sail": "bin/sail.sh",
    "sail-running": "bin/sail-running.sh",
    "secret": "bin/secret.sh",
    "php-test-layout": "bin/php-test-layout.sh",
    "seed": "bin/seed.sh",
    "serve": "bin/serve.sh",
    "smee": "bin/smee.sh",
    "srv": "bin/srv.sh"
  },
  "scripts": {
    "configure-composer": "./configure-composer.sh",
    "configure-deployer": "./configure-deployer.sh",
    "configure-sail": "./configure-sail.sh",
    "install": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then install-feature -s .; fi",
    "postinstall": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then configure-feature -s . larasets; fi",
    "test": "bats tests/",
    "update": "npm-check-updates -i -u",
    "update-all": "npm run update -ws --root"
  },
  "dependencies": {
    "npm-check-updates": "*"
  },
  "peerDependencies": {
    "@tomgrv/devcontainer-features-common-utils": "*"
  },
  "peerDependenciesMeta": {
    "@tomgrv/devcontainer-features-common-utils": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomgrv/devcontainer-features.git",
    "directory": "src/larasets"
  }
}
