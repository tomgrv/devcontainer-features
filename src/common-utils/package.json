{
    "name": "@tomgrv/devcontainer-features-common-utils",
    "description": "Common utilities and helper scripts for devcontainer features",
    "version": "7.18.0",
    "bin": {
        "configure-feature": "bins/_configure-feature.sh",
        "install-bin": "bins/_install-bin.sh",
        "install-feature": "bins/_install-feature.sh",
        "normalize-json": "bins/_normalize-json.sh",
        "validate-json": "bins/_validate-json.sh",
        "zz_args": "bins/_zz_args.sh",
        "zz_ask": "bins/_zz_ask.sh",
        "zz_colors": "bins/_zz_colors.sh",
        "zz_context": "bins/_zz_context.sh",
        "zz_dispatch": "bins/_zz_dispatch.sh",
        "zz_dist": "bins/_zz_dist.sh",
        "zz_edit": "bins/_zz_edit.sh",
        "zz_input": "bins/_zz_input.sh",
        "zz_json": "bins/_zz_json.sh",
        "zz_log": "bins/_zz_log.sh",
        "zz_npx": "bins/_zz_npx.sh",
        "zz_persist": "bins/_zz_persist.sh",
        "zz_prompt": "bins/_zz_prompt.sh"
    },
    "dependencies": {},
    "files": [
        "bins/*.sh",
        "configs/**/*",
        "install.sh",
        "stubs/**/*"
    ],
    "scripts": {
        "install": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then sh ./install.sh; fi",
        "postinstall": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then configure-feature -s . common-utils; fi"
    }
}
