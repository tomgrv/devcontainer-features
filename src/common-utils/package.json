{
    "name": "@tomgrv/devcontainer-features-common-utils",
    "version": "8.0.0",
    "description": "Common utilities and helper scripts for devcontainer features",
    "files": [
        "bin/*.sh",
        "config/**/*",
        "configure-*.sh",
        "install.sh",
        "stubs/**/*"
    ],
    "bin": {
        "normalize-json": "bin/normalize-json.sh",
        "validate-json": "bin/validate-json.sh",
        "zz_args": "bin/zz_args.sh",
        "zz_ask": "bin/zz_ask.sh",
        "zz_colors": "bin/zz_colors.sh",
        "zz_context": "bin/zz_context.sh",
        "zz_dispatch": "bin/zz_dispatch.sh",
        "zz_dist": "bin/zz_dist.sh",
        "zz_edit": "bin/zz_edit.sh",
        "zz_feature": "bin/zz_feature.sh",
        "zz_input": "bin/zz_input.sh",
        "zz_json": "bin/zz_json.sh",
        "zz_log": "bin/zz_log.sh",
        "zz_npx": "bin/zz_npx.sh",
        "zz_persist": "bin/zz_persist.sh",
        "zz_prompt": "bin/zz_prompt.sh"
    },
    "scripts": {
        "install": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then zz_feature -i -s .; fi",
        "postinstall": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then zz_feature -c -s . common-utils; fi"
    },
    "dependencies": {}
}
