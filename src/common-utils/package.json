{
    "name": "@tomgrv-devcontainer-features/common-utils",
    "version": "7.15.0",
    "description": "Common utilities and helper scripts for devcontainer features",
    "files": [
        "_*.sh",
        "_*.json",
        "install.sh",
        "stubs/**/*"
    ],
    "bin": {
        "configure-feature": "_configure-feature.sh",
        "install-bin": "_install-bin.sh",
        "install-feature": "_install-feature.sh",
        "normalize-json": "_normalize-json.sh",
        "validate-json": "_validate-json.sh",
        "zz_args": "_zz_args.sh",
        "zz_ask": "_zz_ask.sh",
        "zz_colors": "_zz_colors.sh",
        "zz_context": "_zz_context.sh",
        "zz_dispatch": "_zz_dispatch.sh",
        "zz_dist": "_zz_dist.sh",
        "zz_edit": "_zz_edit.sh",
        "zz_input": "_zz_input.sh",
        "zz_json": "_zz_json.sh",
        "zz_log": "_zz_log.sh",
        "zz_npx": "_zz_npx.sh",
        "zz_persist": "_zz_persist.sh",
        "zz_prompt": "_zz_prompt.sh"
    },
    "scripts": {
        "install": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then sh ./install.sh; fi",
        "postinstall": "if [ \"$INIT_CWD\" = \"$PWD\" ]; then configure-feature -s . common-utils; fi"
    },
    "dependencies": {}
}
