{
    "image": "mcr.microsoft.com/devcontainers/base:noble",
    "name": "",
    "features": {
        "ghcr.io/tomgrv/devcontainer-features/ai-coding:10": {},
        "ghcr.io/tomgrv/devcontainer-features/githooks:10": {},
        "ghcr.io/tomgrv/devcontainer-features/gitutils:10": {}
    },
    "remoteEnv": {},
    "postCreateCommand": {},
    "postStartCommand": {
        "gpg": "if [ -z \"$CODESPACES\" ]; then git config --global gpg.program gpg2 || true; fi",
        "safe": "git config --global --add safe.directory \"${containerWorkspaceFolder:-.}\"",
        "npm": "if [ -f package.json ] && command -v npm > /dev/null 2>&1; then npm install; fi"
    },
    "customizations": {}
}
